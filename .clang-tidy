---
# Focused on bugs and performance; style checks are left to clang-format.
# unnecessary-value-param is off: Hyprland passes its smart pointers by value
# and hook destinations must match its signatures exactly.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  cppcoreguidelines-pro-type-cstyle-cast,
  cppcoreguidelines-special-member-functions,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-using,
  performance-*,
  -performance-enum-size,
  -performance-unnecessary-value-param,
  readability-const-return-type,
  readability-redundant-smartptr-get
HeaderFilterRegex: '.*/hyprtasking/src/.*'
# Hyprland's APICALL plugin entry points return C++ types from extern "C".
ExtraArgs: ['-Wno-return-type-c-linkage']
SystemHeaders: false
CheckOptions:
  cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor: true
  cppcoreguidelines-special-member-functions.AllowMissingMoveFunctionsWhenCopyIsDeleted: true
